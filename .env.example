# Docker Hub의 Public Repository 소유자 이름
DOCKERHUB_USERNAME=your-dockerhub-username

# 최초 프론트엔드 이미지 버전이며, 이후에는 프론트 배포 스크립트가 이 값을 갱신한다.
FRONTEND_TAG=0.1.0

# 백엔드 A/B 이미지 태그와 현재 활성 슬롯은 배포 스크립트가
# Git에 포함되지 않는 runtime/deployment.env에서 관리한다.

# EC2에서는 80을 사용한다. 로컬에서 충돌하면 8081 등으로 변경할 수 있다.
HTTP_PORT=80

# RDS 콘솔에서 확인한 endpoint와 초기 데이터베이스 정보를 입력한다.
RDS_ENDPOINT=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
RDS_PORT=3306
RDS_DATABASE=your-database-name
RDS_USERNAME=your-rds-username
RDS_PASSWORD=replace-with-your-rds-password

# 기존 Hibernate 스키마를 Flyway에 최초 등록하는 배포에서만 true로 설정한다.
# flyway_schema_history가 생성된 것을 확인한 뒤 false로 되돌린다.
FLYWAY_BASELINE_ON_MIGRATE=false

S3_BUCKET=your-private-s3-bucket
AWS_REGION=ap-northeast-2

JWT_SECRET=replace-with-your-jwt-secret
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=30d
